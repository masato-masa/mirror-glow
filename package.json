{
  "name": "mirror-glow",
  "version": "0.1.0",
  "description": "かがみのひかり — 鏡をひっくり返して、光を星まで届けるパズル",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite --port 5262 --strictPort",
