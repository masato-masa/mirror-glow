    "deploy": "node scripts/deploy-pages.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
